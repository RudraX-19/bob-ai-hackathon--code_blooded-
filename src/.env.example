# IBM watsonx.ai credentials (optional - app works in mock mode without these)
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# AISStream.io real-time vessel tracking
# Sign up at https://aisstream.io to get a free API key
AIS_API_KEY=your_aisstream_api_key_here

# App settings
APP_PORT=8000
MOCK_MODE=true
